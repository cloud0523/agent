# ============================================================
# RAG Agent Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Embedding Provider ---
# Options: "local" (no API key needed), "openai"
EMBEDDING_PROVIDER=local

# Local embedding model (used when EMBEDDING_PROVIDER=local)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# OpenAI embedding (used when EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM Provider ---
# Options: "claude", "openai", "ollama"
LLM_PROVIDER=claude

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI (used when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Ollama (used when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNKING_STRATEGY=recursive

# --- Retrieval ---
TOP_K=5
SIMILARITY_THRESHOLD=0.7
USE_RERANKER=false

# --- Storage ---
DATA_DIR=data
CHROMA_PERSIST_DIR=data/chroma
DOC_STORE_PATH=data/metadata.db

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Conversation ---
MAX_HISTORY_TURNS=10
MAX_CONTEXT_TOKENS=4000

# --- Logging ---
LOG_LEVEL=INFO
